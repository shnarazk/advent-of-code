// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Debug AoC",
    "sourceLanguages": ["rust"],
    "adapter": "CodeLLDB",
    "build": {
      "command": "cargo",
      "args": ["build"],
    },
    "request": "launch",
    "program": "~/.cargo/target/debug/adventofcode",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": ["10", "0"],
    "env": {
      "PATH": "/Library/Developer/CommandLineTools/Library/PrivateFrameworks/LLDB.framework/Resources:${env:PATH}"
    },
    // "env": {"PATH": "~/.local/bin:${env:PATH}"},
  },
]
